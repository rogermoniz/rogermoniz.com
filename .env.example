# ---------------------------------------------------------------------------
# Supabase project: rogermoniz (isjzvhhleoukhjbebvje)
# ---------------------------------------------------------------------------

# Public. Safe in the browser: every content table is public-select only, with
# no write policy, so this key can only ever read.
NEXT_PUBLIC_SUPABASE_URL=https://isjzvhhleoukhjbebvje.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# CMS. Server only — never prefix these NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Bypasses row level security. This is what lets the CMS write.
SUPABASE_SECRET_KEY=

# Sign in for admin.rogermoniz.com.
ADMIN_PASSWORD=

# Any long random string. Signs the admin session cookie:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary. Optional: without these the editor still accepts a pasted
# Cloudinary link and can reuse any image already on the site, but the
# Téléverser button is hidden because uploading needs a signed request.
# Find them in the Cloudinary console under Settings → API Keys.
# ---------------------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=dfbuajiyj
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: drop new uploads into a folder rather than the account root.
CLOUDINARY_FOLDER=
