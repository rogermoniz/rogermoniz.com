# Public. Safe in the browser: every content table is public-select only, with
# no write policy, so this key can only ever read.
NEXT_PUBLIC_SUPABASE_URL=https://isjzvhhleoukhjbebvje.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# CMS. Server only — never prefix these NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Bypasses row level security. This is what lets the CMS write.
SUPABASE_SECRET_KEY=

# Sign in for admin.rogermoniz.com.
ADMIN_PASSWORD=

# Any long random string. Signs the admin session cookie:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=
